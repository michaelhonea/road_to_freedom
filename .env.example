# Copy to .env for local use. NEVER commit .env to GitHub.
APP_NAME=Road to Freedom
CHURCH_NAME=New Covenant Church of God
TIMEZONE=America/New_York

# Leader login + cookie signing. Use a long random SECRET_KEY.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pick-a-strong-password
SECRET_KEY=replace-with-long-random-string

# SQLite for local. On Render use the free Postgres URL it gives you.
DATABASE_URL=sqlite:///./data/app.db

# Texting. Leave SMS_DRY_RUN=true until Twilio is approved; texts are only logged.
SMS_DRY_RUN=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# AI question box
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only if your host sleeps (free tier): secret for the external pinger URL /tasks/tick?token=...
CRON_TOKEN=

DAILY_NOTE_HOUR=7
DAILY_NOTE_MINUTE=30
ASK_LIMIT_PER_HOUR=20
